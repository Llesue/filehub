{
  "listen": "0.0.0.0:8080",
  "db_path": "/var/lib/filehub/filehub.db",
  "users_root": "/srv/filehub/users",
  "cache_dir": "/var/cache/filehub",
  "thumbnails": {
    "enabled": true,
    "workers": 2,
    "max_source_bytes": 52428800,
    "max_pixels": 50000000,
    "video": true,
    "video_seek_seconds": 1,
    "video_timeout_secs": 15,
    "cache_max_bytes": 2147483648
  },
  "symlinks": {
    "allow_create": true,
    "follow_in_index": false,
    "follow_admin_links": true,
    "max_depth": 32,
    "max_hops": 40
  },
  "index": {
    "ignore": [".git", "node_modules", "@eaDir"],
    "max_entries_per_dir": 200000,
    "auto_index_on_browse": true,
    "scheduled_scans": true,
    "quick_scan_minutes": 10,
    "full_scan_hours": 24
  },
  "uploads": {
    "max_file_bytes": 10737418240,
    "chunk_size": 8388608,
    "session_ttl_hours": 24,
    "concurrency_per_user": 2
  },
  "downloads": {
    "zip_max_bytes": 2147483648,
    "zip_max_files": 1000,
    "zip_concurrency": 1
  },
  "editor": {
    "enabled": true,
    "max_file_bytes": 2097152
  },
  "ui": {
    "default_theme": "system",
    "default_locale": "en",
    "locales": ["zh-CN", "en"]
  },
  "security": {
    "session_ttl_hours": 168,
    "cookie_secure": false,
    "trusted_proxies": []
  },
  "jobs": {
    "io_workers": 1,
    "queue_max": 256,
    "dir_size_ttl_seconds": 300,
    "dir_size_error_retry_seconds": 60,
    "usage_cache_seconds": 45,
    "dir_size_use_logical": true,
    "audit_retention_days": 90,
    "audit_max_rows": 200000,
    "job_retention_days": 30
  },
  "log": { "level": "info", "format": "text" }
}
